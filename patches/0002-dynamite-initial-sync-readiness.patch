--- /dev/null
+++ b/hook/src/DynamiteSyncImpl/InitialVarSync.h
@@ -0,0 +1,61 @@
+#ifndef DYNAMITE_INITIAL_VAR_SYNC_H
+#define DYNAMITE_INITIAL_VAR_SYNC_H
+
+#include <algorithm>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace Dynamite {
+    // Tracks successful required svars handlers, not peer liveness or world readiness.
+    // A generation rejects handlers overlapping a local reset; it is not a wire epoch.
+    class InitialVarSync {
+      public:
+        void Reset() {
+            std::lock_guard lock(mutex);
+            ++generation;
+            status.clear();
+        }
+
+        void Begin(const std::vector<std::string> &required) {
+            std::lock_guard lock(mutex);
+            ++generation;
+            status.clear();
+            for (const auto &name : required) status.emplace(name, false);
+        }
+
+        std::uint64_t Generation() const {
+            std::lock_guard lock(mutex);
+            return generation;
+        }
+
+        void Record(std::uint64_t token, std::string_view category, std::string_view name, bool applied) {
+            std::lock_guard lock(mutex);
+            if (token != generation || category != "svars") return;
+            const auto entry = status.find(name);
+            if (entry != status.end()) entry->second = applied;
+        }
+
+        bool Ready() const {
+            std::lock_guard lock(mutex);
+            return !status.empty() && std::all_of(status.begin(), status.end(),
+                [](const auto &entry) { return entry.second; });
+        }
+
+        std::vector<std::string> Pending() const {
+            std::lock_guard lock(mutex);
+            std::vector<std::string> result;
+            for (const auto &[name, applied] : status) if (!applied) result.push_back(name);
+            return result;
+        }
+
+      private:
+        mutable std::mutex mutex;
+        std::uint64_t generation = 0;
+        std::map<std::string, bool, std::less<>> status;
+    };
+}
+#endif
