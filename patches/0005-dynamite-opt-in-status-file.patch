diff --git a/moddata/standalone/WWRuntimeBridge.lua b/moddata/standalone/WWRuntimeBridge.lua
new file mode 100644
--- /dev/null
+++ b/moddata/standalone/WWRuntimeBridge.lua
@@ -0,0 +1,58 @@
+-- Test-only status-file transport. Native default builds always refuse Due().
+local e = { schema = 1 }
+local busy = false
+local function escape(value)
+    return '"' .. value:gsub('[%z\1-\31\\"]', function(c)
+        if c == '"' then return '\\"' end
+        if c == '\\' then return '\\\\' end
+        return string.format('\\u%04x', string.byte(c))
+    end) .. '"'
+end
+local function encode(value, depth)
+    if depth > 8 then error("observation nesting") end
+    local kind = type(value)
+    if kind == "boolean" then return value and "true" or "false" end
+    if kind == "string" then if #value > 256 then error("observation string") end; return escape(value) end
+    if kind == "number" then
+        if value ~= value or math.abs(value) > 1000000 then error("observation number") end
+        return string.format("%.17g", value):gsub(",", ".")
+    end
+    if kind ~= "table" or getmetatable(value) ~= nil then error("observation type") end
+    local keys, rows = {}, {}
+    for key in pairs(value) do
+        if type(key) ~= "string" or #key > 64 then error("observation key") end
+        keys[#keys+1] = key
+        if #keys > 32 then error("observation fields") end
+    end
+    table.sort(keys)
+    for _,key in ipairs(keys) do rows[#rows+1] = escape(key) .. ":" .. encode(value[key], depth+1) end
+    return "{" .. table.concat(rows, ",") .. "}"
+end
+function e.Poll()
+    if busy then return false end
+    local native = rawget(_G, "Dynamite")
+    if type(native) ~= "table" then return false end
+    local dueFn = rawget(native, "RuntimeObservationDue")
+    if type(dueFn) ~= "function" then return false end
+    local ok, due = pcall(dueFn)
+    if not ok or due ~= true then return false end
+    busy = true
+    local success, result = pcall(function()
+        local observer = rawget(_G, "WWRuntimeObservation")
+        if type(observer) ~= "table" or observer.schema ~= 1 or type(observer.Snapshot) ~= "function"
+            or type(native.PublishRuntimeObservation) ~= "function" then return false end
+        local text = encode(observer.Snapshot(), 0)
+        if #text > 16384 then return false end
+        return native.PublishRuntimeObservation(text) == true
+    end)
+    busy = false
+    return success and result == true
+end
+function e.Suspend()
+    local native = rawget(_G, "Dynamite")
+    if type(native) == "table" then
+        local stop = rawget(native, "StopRuntimeObservation")
+        if type(stop) == "function" then pcall(stop) end
+    end
+end
+return e
