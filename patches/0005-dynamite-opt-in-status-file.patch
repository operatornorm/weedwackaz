+++ b/hook/src/CoopStatusFile.h
@@ -0,0 +1,169 @@
+#ifndef DYNAMITE_COOP_STATUS_FILE_H
+#define DYNAMITE_COOP_STATUS_FILE_H
+
+#include "../third_party/coopbridge/json.h"
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <mutex>
+#include <set>
+#include <thread>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+
+namespace Dynamite::QA {
+    using Json = coopbridge::json::Value;
+    inline bool Keys(const Json &v, const std::set<std::string> &keys) {
+        if (!v.isObject()) return false;
+        for (const auto &[key, value] : v.members()) { (void)value; if (!keys.contains(key)) return false; }
+        return true;
+    }
+    inline bool Flag(const Json &v, bool expected) { return v.isBool() && v.asBool() == expected; }
+    inline bool Integer(const Json &v, double limit) {
+        return v.isNumber() && std::isfinite(v.asNumber()) && v.asNumber() >= 0
+            && v.asNumber() <= limit && v.asNumber() == std::floor(v.asNumber());
+    }
+    inline bool Digits(const Json &v) {
+        if (!v.isString() || v.str().empty() || v.str().size() > 20) return false;
+        return v.str().find_first_not_of("0123456789") == std::string::npos;
+    }
+    inline bool Vector(const Json &v) {
+        if (!Keys(v, {"x", "y", "z"}) || v.members().size() != 3) return false;
+        for (const auto &[key, value] : v.members()) {
+            (void)key;
+            if (!value.isNumber() || !std::isfinite(value.asNumber()) || std::abs(value.asNumber()) > 1000000) return false;
+        }
+        return true;
+    }
+    inline bool Observation(const Json &v) {
+        if (!Keys(v, {"schema", "observation_only", "can_authorize", "coherent_snapshot_verified", "native", "context", "player_slots", "verification"})
+            || !Integer(v.get("schema"), 1) || v.get("schema").asNumber() != 1
+            || !Flag(v.get("observation_only"), true) || !Flag(v.get("can_authorize"), false)
+            || !Flag(v.get("coherent_snapshot_verified"), false)) return false;
+        const auto &n = v.get("native");
+        if (!Keys(n, {"status", "native_available", "configured_role", "session_created_bookkeeping", "host_session_created_bookkeeping",
+            "session_connected_bookkeeping", "sample_counter_exhausted", "initial_vars_handlers_complete", "sample_id", "initial_vars_generation",
+            "initial_vars_required", "initial_vars_applied", "member_query_status", "engine_member_count"})) return false;
+        if (!n.get("status").isString() || (n.get("status").str() != "observed" && n.get("status").str() != "unavailable")) return false;
+        for (const auto &[key, value] : n.members()) {
+            if (key == "status") continue;
+            if (key == "sample_id" || key == "initial_vars_generation") { if (!Digits(value)) return false; }
+            else if (key == "configured_role") { if (!value.isString() || (value.str() != "host" && value.str() != "client" && value.str() != "unknown")) return false; }
+            else if (key == "member_query_status") {
+                if (!value.isString() || !std::set<std::string>{"unavailable", "mod_session_not_created", "native_api_unavailable", "main_session_unavailable", "native_count_out_of_range", "native_count_observed"}.contains(value.str())) return false;
+            } else if (key == "engine_member_count") { if (!Integer(value, 16) || n.get("member_query_status").asString() != "native_count_observed") return false; }
+            else if (key == "initial_vars_required" || key == "initial_vars_applied") { if (!Integer(value, 4)) return false; }
+            else if (!value.isBool()) return false;
+        }
+        const auto &context = v.get("context");
+        if (!Keys(context, {"mission", "location", "sequence_name", "sequence_index", "prepare_finished", "not_playable", "world_center", "local_position", "local_player_index"})) return false;
+        for (const auto &[key, value] : context.members()) {
+            if (key == "world_center" || key == "local_position") { if (!Vector(value)) return false; }
+            else if (key == "prepare_finished" || key == "not_playable") { if (!value.isBool()) return false; }
+            else if (key == "sequence_name") {
+                if (!value.isString() || value.str().empty() || value.str().size() > 128
+                    || value.str().find_first_not_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789") != std::string::npos) return false;
+            } else if (!Integer(value, key == "local_player_index" ? 1 : 65535)) return false;
+        }
+        if (!Keys(v.get("player_slots"), {"slot0_present", "slot1_present"})) return false;
+        for (const auto &[key, value] : v.get("player_slots").members()) { (void)key; if (!value.isBool()) return false; }
+        const auto &proofs = v.get("verification");
+        if (!Keys(proofs, {"peer_liveness", "player_realization", "same_world", "center_agreement", "complete_initial_sync", "protocol_epoch", "playable_free_roam_contract", "save_isolation"}) || proofs.members().size() != 8) return false;
+        for (const auto &[key, value] : proofs.members()) { (void)key; if (!Flag(value, false)) return false; }
+        return true;
+    }
+
+    inline bool AtomicStatusWrite(const std::filesystem::path &directory, const std::string &run, const std::string &text) {
+        const auto temporary = directory / ("status-" + run + ".tmp");
+        const auto target = directory / "status.json";
+#ifdef _WIN32
+        auto file = CreateFileW(temporary.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+        if (file == INVALID_HANDLE_VALUE) return false;
+        DWORD written = 0;
+        const bool ok = WriteFile(file, text.data(), static_cast<DWORD>(text.size()), &written, nullptr) && written == text.size();
+        CloseHandle(file);
+        const bool moved = ok && MoveFileExW(temporary.c_str(), target.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH);
+        if (!moved) DeleteFileW(temporary.c_str());
+#else
+        const int file = open(temporary.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600);
+        if (file < 0) return false;
+        const auto written = write(file, text.data(), text.size());
+        const bool ok = written >= 0 && static_cast<std::size_t>(written) == text.size();
+        close(file);
+        const bool moved = ok && rename(temporary.c_str(), target.c_str()) == 0;
+        if (!moved) unlink(temporary.c_str());
+#endif
+        return moved;
+    }
+
+    class StatusFile {
+      public:
+        explicit StatusFile(std::filesystem::path directory) : directory(std::move(directory)) {}
+        bool Due(const void *lua, std::uint64_t now) {
+            std::lock_guard lock(mutex);
+            if (owner && (owner != lua || thread != std::this_thread::get_id())) return false;
+            if (now < nextCheck) return false;
+            nextCheck = now + 500;
+            const auto requested = Request();
+            if (requested.empty() || requested == blocked) { active.clear(); return false; }
+            if (requested != active) {
+                if (generation == std::numeric_limits<std::uint64_t>::max()) return false;
+                active = requested; ++generation; frame = 0;
+                owner = lua; thread = std::this_thread::get_id();
+            }
+            permit = true;
+            return true;
+        }
+        bool Publish(const void *lua, const std::string &json, std::uint64_t now) {
+            std::lock_guard lock(mutex);
+            if (!permit || !owner || owner != lua || thread != std::this_thread::get_id()) return false;
+            permit = false;
+            if (active.empty() || Request() != active
+                || json.size() > 16384 || frame == std::numeric_limits<std::uint64_t>::max()) return false;
+            Json observation; std::string error;
+            if (!coopbridge::json::parse(json, observation, error) || !Observation(observation)) return false;
+            auto result = Json::object();
+            result.set("schema", 1).set("kind", "mgsv_observer_status").set("observation_only", true).set("can_authorize", false)
+                .set("run_id", active).set("generation", std::to_string(generation)).set("frame_id", std::to_string(frame + 1))
+                .set("publisher_tick_ms", std::to_string(now)).set("caller_affinity_checked", true).set("observation", observation);
+            if (!AtomicStatusWrite(directory, active, result.dump() + "\n")) return false;
+            ++frame;
+            return true;
+        }
+        void Stop(const void *lua) {
+            std::lock_guard lock(mutex);
+            if (owner && (owner != lua || thread != std::this_thread::get_id())) return;
+            if (!active.empty()) blocked = active;
+            active.clear(); permit = false;
+            // The old file cannot be refreshed; the reader requires advancing frame IDs.
+        }
+      private:
+        std::string Request() const {
+            std::error_code error;
+            if (std::filesystem::is_symlink(std::filesystem::symlink_status(directory, error)) || error) return {};
+            if (std::filesystem::is_symlink(std::filesystem::symlink_status(directory.parent_path(), error)) || error) return {};
+            const auto requestStatus = std::filesystem::symlink_status(directory / "request.txt", error);
+            if (error || !std::filesystem::is_regular_file(requestStatus)) return {};
+            if (std::filesystem::file_size(directory / "request.txt", error) != 39 || error) return {};
+            std::ifstream input(directory / "request.txt", std::ios::binary);
+            std::string text(40, '\0'); input.read(text.data(), static_cast<std::streamsize>(text.size()));
+            text.resize(static_cast<std::size_t>(input.gcount()));
+            if (text.size() != 39 || text.substr(0, 6) != "WWQA1\n" || text.back() != '\n') return {};
+            auto run = text.substr(6, 32);
+            return run.find_first_not_of("0123456789abcdef") == std::string::npos ? run : std::string{};
+        }
+        std::filesystem::path directory;
+        std::mutex mutex;
+        const void *owner = nullptr;
+        std::thread::id thread;
+        std::string active, blocked;
+        bool permit = false;
+        std::uint64_t generation = 0, frame = 0, nextCheck = 0;
+    };
+}
+#endif
