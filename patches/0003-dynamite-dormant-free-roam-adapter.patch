diff --git a/moddata/free_roam_test.go b/moddata/free_roam_test.go
new file mode 100644
--- /dev/null
+++ b/moddata/free_roam_test.go
@@ -0,0 +1,38 @@
+package moddata
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestFreeRoamAdapterModulesAreEmbeddedAndMappedOnce(t *testing.T) {
+	for _, name := range []string{"WWFreeRoamManifest", "WWFreeRoam"} {
+		source := "standalone/" + name + ".lua"
+		if _, err := ModData.ReadFile(source); err != nil {
+			t.Fatal("adapter module missing from embedded files", name, err)
+		}
+		count := 0
+		for _, replacement := range ReplaceInQAR {
+			if replacement.FileName == "/Assets/tpp/script/lib/"+name+".lua" {
+				if replacement.SourceFile != source {
+					t.Fatal("adapter module has wrong source mapping", name)
+				}
+				count++
+			}
+		}
+		if count != 1 {
+			t.Fatal("adapter module mapping must be unique", name, count)
+		}
+	}
+	data, err := ModData.ReadFile("standalone/Tpp.lua")
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(data)
+	manifest := strings.Index(text, "/Assets/tpp/script/lib/WWFreeRoamManifest.lua")
+	adapter := strings.Index(text, "/Assets/tpp/script/lib/WWFreeRoam.lua")
+	main := strings.Index(text, "/Assets/tpp/script/lib/TppMain.lua")
+	if manifest < 0 || adapter <= manifest || main <= adapter {
+		t.Fatal("adapter dependencies must precede TppMain in declared load order")
+	}
+}
