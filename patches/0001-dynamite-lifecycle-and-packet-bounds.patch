diff --git a/hook/src/DynamiteSyncImpl/WireBounds.h b/hook/src/DynamiteSyncImpl/WireBounds.h
new file mode 100644
index 0000000..6bf90ea
--- /dev/null
+++ b/hook/src/DynamiteSyncImpl/WireBounds.h
@@ -0,0 +1,26 @@
+#ifndef DYNAMITE_WIRE_BOUNDS_H
+#define DYNAMITE_WIRE_BOUNDS_H
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+
+namespace Dynamite::Wire {
+    inline constexpr std::size_t HeaderSize = 8;
+    inline constexpr std::size_t MaxPayloadSize = 1024;
+
+    constexpr bool CanSendPayload(std::size_t size) noexcept {
+        return size > 0 && size <= MaxPayloadSize;
+    }
+
+    constexpr std::optional<std::size_t> PayloadSize(std::int32_t packetSize) noexcept {
+        // Validate signed input before subtracting or converting to size_t.
+        if (packetSize <= static_cast<std::int32_t>(HeaderSize) ||
+            packetSize > static_cast<std::int32_t>(HeaderSize + MaxPayloadSize)) {
+            return std::nullopt;
+        }
+        return static_cast<std::size_t>(packetSize) - HeaderSize;
+    }
+}
+
+#endif
