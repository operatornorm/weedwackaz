+++ b/hook/src/SteamInviteBindings.h
@@ -0,0 +1,225 @@
+#ifndef DYNAMITE_STEAM_INVITE_BINDINGS_H
+#define DYNAMITE_STEAM_INVITE_BINDINGS_H
+
+// ABI facts verified against ValveSoftware/Proton e91ca2be0df2cef4c230cbbc0b86604d73a0bbf6,
+// lsteamclient/steamworks_sdk_135/{steam_api.h,steam_api_flat.h,isteamfriends.h}.
+// These are local declarations, not redistributed SDK source. AMD64 only.
+#include "SteamInviteProtocol.h"
+#include <algorithm>
+#include <cstddef>
+#include <cstring>
+#include <deque>
+#include <limits>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace Dynamite::Invites {
+    struct SteamId { std::uint64_t value; };
+    static_assert(sizeof(SteamId) == 8 && sizeof(void *) == 8);
+    class CallbackBase {
+      public:
+        virtual void Run(void *) = 0;
+        virtual void Run(void *, bool, std::uint64_t) = 0;
+        virtual int GetCallbackSizeBytes() = 0;
+        bool Registered() const { return (flags & 1) != 0; }
+        bool LayoutMatches() const {
+            const auto *base = reinterpret_cast<const unsigned char *>(this);
+            return reinterpret_cast<const unsigned char *>(&flags) - base == 8
+                && reinterpret_cast<const unsigned char *>(&callbackId) - base == 12;
+        }
+      protected:
+        ~CallbackBase() = default; // The SDK ABI has exactly three virtual slots, no virtual destructor.
+        std::uint8_t flags = 0;
+        int callbackId = 0;
+    };
+    static_assert(sizeof(CallbackBase) == 16);
+    struct RichJoin { SteamId inviter; char connect[256]; };
+    static_assert(sizeof(RichJoin) == 264 && offsetof(RichJoin, connect) == 8);
+
+    struct Api {
+        void *(*client)() = nullptr;
+        std::int32_t (*userHandle)() = nullptr;
+        std::int32_t (*pipeHandle)() = nullptr;
+        void *(*friends)(std::intptr_t, std::int32_t, std::int32_t, const char *) = nullptr;
+        void *(*user)(std::intptr_t, std::int32_t, std::int32_t, const char *) = nullptr;
+        void *(*utils)(std::intptr_t, std::int32_t, const char *) = nullptr;
+        std::uint32_t (*appId)(std::intptr_t) = nullptr;
+        std::uint64_t (*localId)(std::intptr_t) = nullptr;
+        int (*relationship)(std::intptr_t, SteamId) = nullptr;
+        bool (*invite)(std::intptr_t, SteamId, const char *) = nullptr;
+        void (*registerCallback)(CallbackBase *, int) = nullptr;
+        void (*unregisterCallback)(CallbackBase *) = nullptr;
+        bool Complete() const {
+            return client && userHandle && pipeHandle && friends && user && utils && appId && localId
+                && relationship && invite && registerCallback && unregisterCallback;
+        }
+    };
+    template <class Resolver> std::optional<Api> Resolve(std::string_view fingerprint, Resolver symbol) {
+        if (fingerprint != SteamDllSha) return std::nullopt;
+        Api api;
+#define WW_STEAM_BIND(member, name) api.member = reinterpret_cast<decltype(api.member)>(symbol(name))
+        WW_STEAM_BIND(client, "SteamClient");
+        WW_STEAM_BIND(userHandle, "SteamAPI_GetHSteamUser");
+        WW_STEAM_BIND(pipeHandle, "SteamAPI_GetHSteamPipe");
+        WW_STEAM_BIND(friends, "SteamAPI_ISteamClient_GetISteamFriends");
+        WW_STEAM_BIND(user, "SteamAPI_ISteamClient_GetISteamUser");
+        WW_STEAM_BIND(utils, "SteamAPI_ISteamClient_GetISteamUtils");
+        WW_STEAM_BIND(appId, "SteamAPI_ISteamUtils_GetAppID");
+        WW_STEAM_BIND(localId, "SteamAPI_ISteamUser_GetSteamID");
+        WW_STEAM_BIND(relationship, "SteamAPI_ISteamFriends_GetFriendRelationship");
+        WW_STEAM_BIND(invite, "SteamAPI_ISteamFriends_InviteUserToGame");
+        WW_STEAM_BIND(registerCallback, "SteamAPI_RegisterCallback");
+        WW_STEAM_BIND(unregisterCallback, "SteamAPI_UnregisterCallback");
+#undef WW_STEAM_BIND
+        if (!api.Complete()) return std::nullopt;
+        return api;
+    }
+    enum class BindStatus { MissingExports, ContextNotReady, WrongApp, InvalidLocalIdentity, Bound };
+    struct Context {
+        Api api;
+        std::intptr_t friends = 0;
+        std::uint64_t local = 0;
+        std::thread::id owner;
+        bool OnOwner() const { return owner == std::this_thread::get_id(); }
+    };
+    inline BindStatus Bind(const Api &api, Context &output) {
+        output = {};
+        if (!api.Complete()) return BindStatus::MissingExports;
+        const auto user = api.userHandle(), pipe = api.pipeHandle();
+        if (user <= 0 || pipe <= 0) return BindStatus::ContextNotReady;
+        const auto *client = api.client();
+        if (!client) return BindStatus::ContextNotReady;
+        const auto instance = reinterpret_cast<std::intptr_t>(client);
+        const auto utils = reinterpret_cast<std::intptr_t>(api.utils(instance, pipe, "SteamUtils007"));
+        if (!utils) return BindStatus::ContextNotReady;
+        if (api.appId(utils) != AppId) return BindStatus::WrongApp;
+        const auto friends = reinterpret_cast<std::intptr_t>(api.friends(instance, user, pipe, "SteamFriends015"));
+        const auto steamUser = reinterpret_cast<std::intptr_t>(api.user(instance, user, pipe, "SteamUser018"));
+        if (!friends || !steamUser) return BindStatus::ContextNotReady;
+        const auto local = api.localId(steamUser);
+        if (!Individual(local)) return BindStatus::InvalidLocalIdentity;
+        output = {api, friends, local, std::this_thread::get_id()};
+        return BindStatus::Bound;
+    }
+
+    // Stable, caller-owned callback storage must outlive registration and any
+    // callback in flight. Run's SDK-owned pointer has the SDK's size contract;
+    // it has no length parameter and is not an arbitrary-buffer validation API.
+    class CallbackQueue final : public CallbackBase {
+      public:
+        struct Event { std::uint64_t generation, inviter; std::array<char, 256> connect; };
+        std::optional<std::uint64_t> EnableNext() {
+            std::lock_guard lock(mutex);
+            if (serial == std::numeric_limits<std::uint64_t>::max()) return std::nullopt;
+            generation = ++serial; count = 0; return generation;
+        }
+        void Disable() { std::lock_guard lock(mutex); generation = 0; count = 0; }
+        void Run(void *pointer) override {
+            if (!pointer) return;
+            std::uint64_t entryGeneration;
+            { std::lock_guard lock(mutex); entryGeneration = generation; }
+            if (!entryGeneration) return;
+            RichJoin incoming; std::memcpy(&incoming, pointer, sizeof incoming);
+            const auto *end = static_cast<const char *>(std::memchr(incoming.connect, 0, sizeof incoming.connect));
+            if (!end || !Individual(incoming.inviter.value)) return;
+            const std::string_view text(incoming.connect, static_cast<std::size_t>(end - incoming.connect));
+            if (!text.starts_with(Prefix)) return; // Ordinary game/MGO events remain untouched.
+            std::lock_guard lock(mutex);
+            if (generation != entryGeneration || count == events.size()) return;
+            events[count] = {generation, incoming.inviter.value, {}};
+            std::copy(text.begin(), text.end(), events[count].connect.begin()); ++count;
+        }
+        void Run(void *pointer, bool ioFailure, std::uint64_t) override { if (!ioFailure) Run(pointer); }
+        int GetCallbackSizeBytes() override { return sizeof(RichJoin); }
+        std::vector<Event> Drain() {
+            std::lock_guard lock(mutex);
+            std::vector<Event> result(events.begin(), events.begin() + count); count = 0; return result;
+        }
+      private:
+        std::mutex mutex;
+        std::uint64_t generation = 0, serial = 0;
+        std::array<Event, 8> events{};
+        std::size_t count = 0;
+    };
+    struct ActivationProof {
+        bool saveIsolation = false, resourceContract = false, peerProtocol = false, mgoRouting = false;
+        bool Complete() const { return saveIsolation && resourceContract && peerProtocol && mgoRouting; }
+    };
+    class Channel {
+      public:
+        Channel(Context context, CallbackQueue &callback) : context(context), callback(callback) {}
+        Channel(const Channel &) = delete;
+        Channel &operator=(const Channel &) = delete;
+        Channel(Channel &&) = delete;
+        Channel &operator=(Channel &&) = delete;
+        // Call only after Steam's callback owner is established, outside loader lock.
+        bool StartObserving() {
+            if (!context.OnOwner() || !context.api.Complete() || registered || callback.Registered()
+                || !callback.LayoutMatches()) return false;
+            const auto token = callback.EnableNext();
+            if (!token) return false;
+            generation = *token;
+            context.api.registerCallback(&callback, 337);
+            registered = callback.Registered();
+            if (!registered) { callback.Disable(); context.api.unregisterCallback(&callback); }
+            operational = registered;
+            return operational;
+        }
+        bool Stop() {
+            if (!context.OnOwner()) return false;
+            operational = false;
+            callback.Disable();
+            pending.reset(); seen.clear(); attempted.clear();
+            if (registered) {
+                context.api.unregisterCallback(&callback);
+                if (callback.Registered()) return false;
+                registered = false;
+            }
+            return true;
+        }
+        bool Send(std::uint64_t friendId, const Intent &intent, const ActivationProof &proof, std::uint64_t now) {
+            if (!context.OnOwner() || !operational || !registered || !proof.Complete() || !Individual(friendId) || friendId == context.local
+                || intent.host != context.local || !Target(intent.target) || !Session(intent.session)
+                || !intent.epoch || intent.expires <= now || intent.expires - now > 300
+                || context.api.relationship(context.friends, {friendId}) != 3) return false;
+            const auto text = Encode(intent);
+            if (!Parse(text, now)) return false;
+            const auto key = std::to_string(friendId) + ":" + text;
+            if (std::find(attempted.begin(), attempted.end(), key) != attempted.end() || attempted.size() >= 32) return false;
+            attempted.push_back(key); // No automatic retry, including an ambiguous/failed send.
+            return context.api.invite(context.friends, {friendId}, text.c_str());
+        }
+        bool Poll(std::uint64_t now) {
+            if (!context.OnOwner() || !operational || !registered) return false;
+            if (pending && !Parse(Encode(*pending), now)) pending.reset();
+            for (const auto &event : callback.Drain()) {
+                if (event.generation != generation || pending) continue;
+                const auto parsed = Parse(std::string_view(event.connect.data()), now);
+                if (!parsed || parsed->host != event.inviter || parsed->host == context.local
+                    || context.api.relationship(context.friends, {event.inviter}) != 3) continue;
+                // Exact callbacks deduplicate, while an explicitly renewed
+                // invitation (new expiry) may retry the same hosted session.
+                const auto key = Encode(*parsed);
+                if (std::find(seen.begin(), seen.end(), key) != seen.end() || seen.size() >= 32) continue;
+                seen.push_back(key); pending = parsed;
+            }
+            return pending.has_value();
+        }
+        std::optional<Intent> TakeIntent(std::uint64_t now) {
+            if (!context.OnOwner()) return std::nullopt;
+            auto result = pending; pending.reset();
+            if (result && !Parse(Encode(*result), now)) result.reset();
+            return result; // Join intent only. No role change, session, mission load or config write.
+        }
+        bool Active() const { return context.OnOwner() && operational; }
+      private:
+        Context context;
+        CallbackQueue &callback;
+        bool registered = false, operational = false;
+        std::uint64_t generation = 0;
+        std::optional<Intent> pending;
+        std::vector<std::string> seen, attempted;
+    };
+}
+#endif
