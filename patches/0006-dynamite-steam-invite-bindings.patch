+
+namespace Dynamite::Invites {
+    enum class ProbeStatus { Disabled, ModuleAbsent, ModuleFingerprintRejected, MissingExports, ContextNotReady, WrongApp, InvalidIdentity, Bound, ProbeFailed };
+    ProbeStatus ProbeLoadedSteamInvites();
