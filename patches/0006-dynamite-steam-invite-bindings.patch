diff --git a/hook/src/SteamInviteProtocol.h b/hook/src/SteamInviteProtocol.h
new file mode 100644
--- /dev/null
+++ b/hook/src/SteamInviteProtocol.h
@@ -0,0 +1,77 @@
+#ifndef DYNAMITE_STEAM_INVITE_PROTOCOL_H
+#define DYNAMITE_STEAM_INVITE_PROTOCOL_H
+
+#include <array>
+#include <charconv>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+
+namespace Dynamite::Invites {
+    inline constexpr std::string_view ExeSha = "f3818d172293800171a344a71957bc7257f591bbf7c1792e10fef6bfbba7f4f2";
+    inline constexpr std::string_view SteamDllSha = "08bd0152356e5619ee56a6714ac951b6800dbb21821693a4efaf85278442c60a";
+    inline constexpr std::string_view Prefix = "+wwcoop=";
+    inline constexpr std::uint32_t AppId = 287700;
+    inline bool Individual(std::uint64_t id) { return id > 0x0110000100000000ULL && id <= 0x01100001ffffffffULL; }
+    inline bool Target(std::string_view target) {
+        return target == "afghanistan-normal" || target == "afghanistan-recover-volgin" || target == "africa-normal";
+    }
+    inline bool Session(std::string_view value) {
+        return value.size() == 32 && value.find_first_not_of("0123456789abcdef") == std::string_view::npos
+            && value.find_first_not_of('0') != std::string_view::npos;
+    }
+    template <class T> bool Decimal(std::string_view text, T &value) {
+        if (text.empty() || text.size() > 20 || (text.size() > 1 && text.front() == '0')) return false;
+        const auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
+        return error == std::errc{} && end == text.data() + text.size() && value > 0;
+    }
+    struct Intent {
+        std::uint64_t host = 0;
+        std::string target, session;
+        std::uint32_t epoch = 0;
+        std::uint64_t expires = 0;
+        bool operator==(const Intent &) const = default;
+    };
+    inline std::optional<Intent> Parse(std::string_view text, std::uint64_t unixSeconds) {
+        if (text.size() > 255 || !text.starts_with(Prefix)) return std::nullopt;
+        text.remove_prefix(Prefix.size());
+        std::array<std::string_view, 8> fields;
+        for (std::size_t i = 0; i < fields.size(); ++i) {
+            const auto separator = text.find(':');
+            if (i + 1 == fields.size()) {
+                if (separator != std::string_view::npos) return std::nullopt;
+                fields[i] = text;
+            } else {
+                if (separator == std::string_view::npos) return std::nullopt;
+                fields[i] = text.substr(0, separator); text.remove_prefix(separator + 1);
+            }
+        }
+        Intent result;
+        if (fields[0] != "1" || fields[1] != "287700" || fields[2] != ExeSha
+            || !Decimal(fields[3], result.host) || !Individual(result.host) || !Target(fields[4])
+            || !Session(fields[5]) || !Decimal(fields[6], result.epoch) || !Decimal(fields[7], result.expires)
+            || result.expires <= unixSeconds || result.expires - unixSeconds > 300) return std::nullopt;
+        result.target = fields[4]; result.session = fields[5];
+        return result;
+    }
+    inline std::string Encode(const Intent &intent) {
+        return std::string(Prefix) + "1:287700:" + std::string(ExeSha) + ":" + std::to_string(intent.host)
+            + ":" + intent.target + ":" + intent.session + ":" + std::to_string(intent.epoch) + ":" + std::to_string(intent.expires);
+    }
+    // Steam appends the direct-invite connect string to the normal launch args.
+    // Parse data only: no shell/URL/Lua evaluation and no launch-option rewriting.
+    inline std::optional<Intent> ColdIntent(std::span<const std::string_view> args, std::uint64_t now) {
+        if (args.size() > 128) return std::nullopt;
+        std::optional<Intent> result;
+        bool seen = false;
+        for (const auto arg : args) {
+            if (!arg.starts_with(Prefix)) continue;
+            if (seen) return std::nullopt;
+            seen = true; result = Parse(arg, now);
+        }
+        return result;
+    }
+}
+#endif
