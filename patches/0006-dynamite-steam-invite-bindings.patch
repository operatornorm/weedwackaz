diff --git a/hook/src/SteamInviteProbe.cpp b/hook/src/SteamInviteProbe.cpp
new file mode 100644
--- /dev/null
+++ b/hook/src/SteamInviteProbe.cpp
@@ -0,0 +1,103 @@
+#include "SteamInviteProbe.h"
+#include "SteamInviteBindings.h"
+
+#if DYNAMITE_QA_STEAM_INVITE_PROBE
+#include <windows.h>
+#include <bcrypt.h>
+#include <array>
+
+namespace Dynamite::Invites {
+    struct LoadedModuleReference {
+        HMODULE value = nullptr;
+        ~LoadedModuleReference() { if (value) FreeLibrary(value); }
+    };
+    struct HashResources {
+        HANDLE file = INVALID_HANDLE_VALUE;
+        BCRYPT_ALG_HANDLE algorithm = nullptr;
+        BCRYPT_HASH_HANDLE hash = nullptr;
+        std::vector<unsigned char> object;
+        ~HashResources() {
+            if (hash) BCryptDestroyHash(hash);
+            if (algorithm) BCryptCloseAlgorithmProvider(algorithm, 0);
+            if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+        }
+    };
+    static bool PinnedModule(HMODULE module) {
+        wchar_t filename[32768];
+        const auto length = GetModuleFileNameW(module, filename, 32768);
+        if (!length || length == 32768) return false;
+        HashResources resources;
+        resources.file = CreateFileW(filename, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
+            FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN, nullptr);
+        if (resources.file == INVALID_HANDLE_VALUE) return false;
+        LARGE_INTEGER size;
+        if (!GetFileSizeEx(resources.file, &size) || size.QuadPart != 211368) return false;
+        bool valid = false;
+        if (BCryptOpenAlgorithmProvider(&resources.algorithm, BCRYPT_SHA256_ALGORITHM, nullptr, 0) >= 0) {
+            DWORD objectSize = 0, received = 0;
+            if (BCryptGetProperty(resources.algorithm, BCRYPT_OBJECT_LENGTH, reinterpret_cast<PUCHAR>(&objectSize), sizeof objectSize, &received, 0) >= 0
+                && received == sizeof objectSize && objectSize > 0 && objectSize < 65536) {
+                resources.object.resize(objectSize);
+                if (BCryptCreateHash(resources.algorithm, &resources.hash, resources.object.data(), objectSize, nullptr, 0, 0) >= 0) {
+                    std::array<unsigned char, 16384> buffer;
+                    DWORD count = 0;
+                    std::uint64_t total = 0;
+                    valid = true;
+                    for (;;) {
+                        if (!ReadFile(resources.file, buffer.data(), buffer.size(), &count, nullptr)) { valid = false; break; }
+                        if (!count) break;
+                        total += count;
+                        if (total > 211368 || BCryptHashData(resources.hash, buffer.data(), count, 0) < 0) { valid = false; break; }
+                    }
+                    std::array<unsigned char, 32> digest;
+                    valid = valid && total == 211368 && BCryptFinishHash(resources.hash, digest.data(), digest.size(), 0) >= 0;
+                    if (valid) {
+                        const char hex[] = "0123456789abcdef"; std::string encoded;
+                        for (const auto byte : digest) { encoded += hex[byte >> 4]; encoded += hex[byte & 15]; }
+                        valid = encoded == SteamDllSha;
+                    }
+                }
+            }
+        }
+        return valid;
+    }
+    ProbeStatus ProbeLoadedSteamInvites() {
+        // Borrow the game's loaded module/context. No LoadLibrary, Init, Shutdown,
+        // callback pumping/registration, invites, rich-presence writes or config.
+        try {
+        LoadedModuleReference module;
+        if (!GetModuleHandleExW(0, L"steam_api64.dll", &module.value)) return ProbeStatus::ModuleAbsent;
+        if (!PinnedModule(module.value)) return ProbeStatus::ModuleFingerprintRejected;
+        const auto api = Resolve(SteamDllSha, [&module](const char *name) { return GetProcAddress(module.value, name); });
+        if (!api) return ProbeStatus::MissingExports;
+        Context context;
+        switch (Bind(*api, context)) {
+        case BindStatus::Bound: return ProbeStatus::Bound;
+        case BindStatus::WrongApp: return ProbeStatus::WrongApp;
+        case BindStatus::InvalidLocalIdentity: return ProbeStatus::InvalidIdentity;
+        case BindStatus::MissingExports: return ProbeStatus::MissingExports;
+        default: return ProbeStatus::ContextNotReady;
+        }
+        } catch (...) { return ProbeStatus::ProbeFailed; }
+    }
+}
+#else
+namespace Dynamite::Invites { ProbeStatus ProbeLoadedSteamInvites() { return ProbeStatus::Disabled; } }
+#endif
+
+namespace Dynamite::Invites {
+    const char *ProbeStatusName(ProbeStatus value) {
+        switch (value) {
+        case ProbeStatus::Disabled: return "disabled";
+        case ProbeStatus::ModuleAbsent: return "module_absent";
+        case ProbeStatus::ModuleFingerprintRejected: return "module_fingerprint_rejected";
+        case ProbeStatus::MissingExports: return "missing_exports";
+        case ProbeStatus::ContextNotReady: return "steam_context_not_ready";
+        case ProbeStatus::WrongApp: return "wrong_app_id";
+        case ProbeStatus::InvalidIdentity: return "local_identity_unavailable";
+        case ProbeStatus::Bound: return "interfaces_bound_read_only";
+        case ProbeStatus::ProbeFailed: return "probe_failed";
+        }
+        return "unavailable";
+    }
+}
