diff --git a/moddata/standalone/WWRuntimeObservation.lua b/moddata/standalone/WWRuntimeObservation.lua
new file mode 100644
--- /dev/null
+++ b/moddata/standalone/WWRuntimeObservation.lua
@@ -0,0 +1,98 @@
+-- Passive, on-demand measurements in the caller's Lua context. No activation,
+-- transport, automatic dispatch, writes or cached Lua-state access.
+local e = { schema = 1 }
+
+local function integer(v, maximum)
+    return type(v) == "number" and v == math.floor(v) and v >= 0 and v <= maximum
+end
+local function finite(v)
+    return type(v) == "number" and v == v and math.abs(v) <= 1000000
+end
+local function call(module, name, ...)
+    local object = rawget(_G, module)
+    if type(object) ~= "table" then return nil end
+    local found, fn = pcall(function() return object[name] end)
+    if not found or type(fn) ~= "function" then return nil end
+    local ok, result = pcall(fn, ...)
+    if ok then return result end
+end
+local function member(object, name)
+    if object == nil then return nil end
+    local ok, value = pcall(function() return object[name] end)
+    if ok then return value end
+end
+local function boolean(value) if type(value) == "boolean" then return value end end
+local function vector(value)
+    if value == nil then return nil end
+    local ok, x, y, z = pcall(function() return value:GetX(), value:GetY(), value:GetZ() end)
+    if ok and finite(x) and finite(y) and finite(z) then return { x = x, y = y, z = z } end
+end
+local function sequence(value)
+    if type(value) == "string" and #value <= 128 and value:match("^[A-Za-z_][A-Za-z0-9_]+$") then return value end
+end
+
+local nativeBooleans = {
+    "session_created_bookkeeping", "host_session_created_bookkeeping", "session_connected_bookkeeping",
+    "sample_counter_exhausted", "initial_vars_handlers_complete",
+}
+local memberStatuses = { unavailable = true, mod_session_not_created = true, native_api_unavailable = true,
+    main_session_unavailable = true, native_count_out_of_range = true, native_count_observed = true }
+local function nativeObservation()
+    local result = { status = "unavailable" }
+    local value = call("Dynamite", "ReadRuntimeObservation")
+    if type(value) ~= "table" or getmetatable(value) ~= nil or value.schema ~= 1
+        or value.observation_only ~= true or value.can_authorize ~= false then return result end
+    result.status = "observed"
+    result.native_available = boolean(value.native_available)
+    if value.configured_role == "host" or value.configured_role == "client" or value.configured_role == "unknown" then
+        result.configured_role = value.configured_role
+    end
+    for _, key in ipairs(nativeBooleans) do result[key] = boolean(value[key]) end
+    for _, key in ipairs({"sample_id", "initial_vars_generation"}) do
+        local v = value[key]
+        if type(v) == "string" and #v <= 20 and v:match("^%d+$") then result[key] = v end
+    end
+    for _, key in ipairs({"initial_vars_required", "initial_vars_applied"}) do
+        if integer(value[key], 4) then result[key] = value[key] end
+    end
+    if memberStatuses[value.member_query_status] then result.member_query_status = value.member_query_status end
+    if value.member_query_status == "native_count_observed" and integer(value.engine_member_count, 16) then
+        result.engine_member_count = value.engine_member_count
+    end
+    return result
+end
+
+function e.Snapshot()
+    local result = { schema = 1, observation_only = true, can_authorize = false,
+        coherent_snapshot_verified = false, native = nativeObservation(), context = {}, player_slots = {} }
+    local context, varsObject = result.context, rawget(_G, "vars")
+    local mission, location = member(varsObject, "missionCode"), member(varsObject, "locationCode")
+    if integer(mission, 65535) then context.mission = mission end
+    if integer(location, 65535) then context.location = location end
+    context.sequence_name = sequence(call("TppSequence", "GetCurrentSequenceName"))
+    local index = call("TppSequence", "GetCurrentSequenceIndex")
+    if integer(index, 65535) then context.sequence_index = index end
+    context.prepare_finished = boolean(call("TppSequence", "IsMissionPrepareFinished"))
+    context.not_playable = boolean(call("TppDemo", "IsNotPlayable"))
+    context.world_center = vector(call("TppCoder", "GetWorldCenter"))
+    local x, y, z = member(varsObject, "playerPosX"), member(varsObject, "playerPosY"), member(varsObject, "playerPosZ")
+    if finite(x) and finite(y) and finite(z) then context.local_position = { x = x, y = y, z = z } end
+    local localIndex = call("PlayerInfo", "GetLocalPlayerIndex")
+    if integer(localIndex, 1) then context.local_player_index = localIndex end
+    local gameObject = rawget(_G, "GameObject")
+    local nullId = member(gameObject, "NULL_ID")
+    if type(gameObject) == "table" and integer(nullId, 65535) then
+        for slot = 0, 1 do
+            local id = call("GameObject", "GetGameObjectIdByIndex", "TppPlayer2", slot)
+            if integer(id, 65535) then result.player_slots["slot" .. slot .. "_present"] = id ~= nullId end
+        end
+    end
+    -- Presence is deliberately separate from realization/liveness; every proof
+    -- remains unavailable, even for a two-member session with two allocated slots.
+    result.verification = { peer_liveness = false, player_realization = false, same_world = false,
+        center_agreement = false, complete_initial_sync = false, protocol_epoch = false,
+        playable_free_roam_contract = false, save_isolation = false }
+    return result
+end
+
+return e
diff --git a/moddata/runtime_observation_test.go b/moddata/runtime_observation_test.go
new file mode 100644
--- /dev/null
+++ b/moddata/runtime_observation_test.go
@@ -0,0 +1,30 @@
+package moddata
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRuntimeObservationModuleEmbeddedAndMappedOnce(t *testing.T) {
+	const source = "standalone/WWRuntimeObservation.lua"
+	const target = "/Assets/tpp/script/lib/WWRuntimeObservation.lua"
+	if _, err := ModData.ReadFile(source); err != nil {
+		t.Fatal(err)
+	}
+	count := 0
+	for _, replacement := range ReplaceInQAR {
+		if replacement.FileName == target {
+			if replacement.SourceFile != source {
+				t.Fatal("observer source mapping differs")
+			}
+			count++
+		}
+	}
+	declaration, err := ModData.ReadFile("standalone/Tpp.lua")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if count != 1 || strings.Count(string(declaration), target) != 1 {
+		t.Fatal("observer must be embedded, mapped and declared exactly once")
+	}
+}
