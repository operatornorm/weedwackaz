+                FoxNtSessionGetMainSession, GetSessionMemberCount);
+            const auto initial = g_hook->dynamiteSyncImpl.ObserveInitialVariables();
+            snapshot.initialGeneration = initial.generation;
+            snapshot.initialRequired = initial.required;
+            snapshot.initialApplied = initial.applied;
+        }
+        lua_createtable(L, 0, 22);
+        VisitCoopRuntimeObservation(snapshot, [L](const char *key, const auto &value) {
+            using Value = std::decay_t<decltype(value)>;
+            if constexpr (std::is_same_v<Value, bool>) lua_pushboolean(L, value);
+            else if constexpr (std::is_same_v<Value, int>) lua_pushinteger(L, value);
+            else lua_pushstring(L, value.c_str());
+            lua_setfield(L, -2, key);
+        });
+        return 1;
+    }
