+    int l_ReadRuntimeObservation(lua_State *L) {
+        static ObservationCounter counter;
+        CoopRuntimeObservation snapshot;
+        snapshot.sample = counter.Next();
+        if (g_hook != nullptr) {
+            snapshot.available = true;
+            snapshot.configuredHost = g_hook->cfg.Host;
+            snapshot.sessionCreated = g_hook->dynamiteCore.GetSessionCreated();
+            snapshot.hostSessionCreated = g_hook->dynamiteCore.GetHostSessionCreated();
