+#ifndef DYNAMITE_COOP_RUNTIME_OBSERVATION_H
+#define DYNAMITE_COOP_RUNTIME_OBSERVATION_H
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <string>
+#include <type_traits>
+
+namespace Dynamite {
+    // Diagnostic counters are local to this DLL instance, never session/peer epochs.
+    class ObservationCounter {
+      public:
+        explicit ObservationCounter(std::uint64_t initial = 0) : value(initial) {}
+        std::optional<std::uint64_t> Next() {
+            auto previous = value.load();
+            while (previous != std::numeric_limits<std::uint64_t>::max()) {
+                if (value.compare_exchange_weak(previous, previous + 1)) return previous + 1;
+            }
+            return std::nullopt;
+        }
+      private:
+        std::atomic<std::uint64_t> value;
+    };
+
+    struct MemberObservation {
+        const char *status = "unavailable";
+        std::optional<int> count;
+    };
+
+    // Same main-session/+0x20 layout already used by DynamiteCore::GetMemberCount
+    // for the pinned regular 1.0.15.3 executable. Never replace unknown with solo.
+    template <class SessionGetter, class CountGetter>
+    MemberObservation ObserveMembers(bool modSessionCreated, SessionGetter getSession, CountGetter getCount) {
+        if (!modSessionCreated) return {"mod_session_not_created", std::nullopt};
+        if (getSession == nullptr || getCount == nullptr) return {"native_api_unavailable", std::nullopt};
+        auto *session = getSession();
+        if (session == nullptr) return {"main_session_unavailable", std::nullopt};
+        const auto count = getCount(static_cast<void *>(static_cast<char *>(session) + 0x20));
+        if (count < 0 || count > 16) return {"native_count_out_of_range", std::nullopt};
+        return {"native_count_observed", count};
+    }
+
+    struct CoopRuntimeObservation {
+        bool available = false;
+        bool configuredHost = false;
+        bool sessionCreated = false;
+        bool hostSessionCreated = false;
+        bool sessionConnected = false;
+        MemberObservation members;
+        std::optional<std::uint64_t> sample;
+        std::uint64_t initialGeneration = 0;
+        std::size_t initialRequired = 0;
+        std::size_t initialApplied = 0;
+    };
+
+    // One fixed scalar allowlist. No pointers, identities, addresses, arbitrary
+    // strings, paths or game assets. Large counters use decimal strings for Lua5.1.
+    template <class Field>
+    void VisitCoopRuntimeObservation(const CoopRuntimeObservation &s, Field field) {
+        field("schema", 1);
+        field("observation_only", true);
+        field("can_authorize", false);
+        field("coherent_snapshot_verified", false);
+        field("native_available", s.available);
+        field("configured_role", std::string(s.available ? (s.configuredHost ? "host" : "client") : "unknown"));
+        field("session_created_bookkeeping", s.sessionCreated);
+        field("host_session_created_bookkeeping", s.hostSessionCreated);
+        field("session_connected_bookkeeping", s.sessionConnected);
+        field("member_query_status", std::string(s.members.status));
+        if (s.members.count) field("engine_member_count", *s.members.count);
+        field("sample_counter_exhausted", !s.sample.has_value());
+        if (s.sample) field("sample_id", std::to_string(*s.sample));
+        field("initial_vars_generation", std::to_string(s.initialGeneration));
+        field("initial_vars_required", static_cast<int>(s.initialRequired));
+        field("initial_vars_applied", static_cast<int>(s.initialApplied));
+        field("initial_vars_handlers_complete", s.initialRequired > 0 && s.initialRequired == s.initialApplied);
+        field("initial_vars_complete_arrays_verified", false);
+        field("peer_liveness_verified", false);
+        field("remote_player_realization_verified", false);
+        field("world_agreement_verified", false);
+        field("protocol_epoch_verified", false);
+    }
+}
+#endif
